<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        GitHub OSS and F-Droid are both built from the oss distribution. They use different package
        IDs and different signing keys, so install only one of them at a time; declaring these names
        from both would cause INSTALL_FAILED_DUPLICATE_PERMISSION.
    -->
    <permission
        android:name="de.szalkowski.activitylauncher.oss.permission.CREATE_SHORTCUT"
        android:knownCerts="@array/trusted_signing_certificates"
        android:protectionLevel="signature|knownSigner"
        tools:targetApi="31" />
    <permission
        android:name="de.szalkowski.activitylauncher.oss.permission.LAUNCH_ACTIVITY"
        android:knownCerts="@array/trusted_signing_certificates"
        android:protectionLevel="signature|knownSigner"
        tools:targetApi="31" />

</manifest>
